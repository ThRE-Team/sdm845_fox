# linexd
on init
    exec u:r:recovery:s0 -- /sbin/linexd.sh
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor "interactive"
    write /sys/devices/system/cpu/cpufreq/policy0/interactive/target_loads 1
    write /sys/devices/system/cpu/cpufreq/policy0/interactive/timer_rate 10000
    write /sys/devices/system/cpu/cpufreq/policy0/interactive/hispeed_freq 1766400
    write /sys/devices/system/cpu/cpufreq/policy0/interactive/go_hispeed_load 10
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/target_loads 1
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/timer_rate 10000
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/hispeed_freq 2803200
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/go_hispeed_load 10

on boot
    start charger_led
    write /sys/class/touch/touch_dev/move_distance_threshold 0
    write /sys/class/touch/touch_dev/click_threshold 1
    write /sys/class/touch/tp_dev/touch_th 1
    write /sys/class/touch/touch_dev/touch_th 1
    write /sys/class/touch/touch_dev/glove_mode 1

service charger_led /system/bin/charger_led
    user root
    group root
    file /dev/kmsg w
    oneshot
    seclabel u:r:recovery:s0
